# 环境变量配置模板
# 复制此文件为 .env 并根据你的集群配置修改

# ==================================================
# 项目路径配置
# ==================================================

# 当前项目根目录（fine_tuing_using_DiffSynth-Studio）
export PROJECT_ROOT="/path/to/fine_tuing_using_DiffSynth-Studio"

# Video Unlearning 项目路径（外部依赖）
export VU_ROOT="/path/to/video-unlearning"

# ==================================================
# 模型路径配置
# ==================================================

# Wan2.2-TI2V-5B 模型路径
export WAN_MODEL_PATH="${PROJECT_ROOT}/models/Wan-AI/Wan2.2-TI2V-5B"
export WAN_MODEL_DIFFUSERS="${PROJECT_ROOT}/models/Wan-AI/Wan2.2-TI2V-5B-Diffusers"

# Qwen3-VL 模型路径（用于 caption 生成）
export QWEN_MODEL_PATH="/path/to/Qwen3-VL-8B-Instruct"

# ==================================================
# 数据路径配置
# ==================================================

# Tiger 数据集路径
export TIGER_DATASET="${PROJECT_ROOT}/data/tiger_dataset"

# VU benchmark 数据路径
export VU_BENCHMARK="${VU_ROOT}/data/benchmark"

# ==================================================
# 输出路径配置
# ==================================================

# 实验输出根目录
export OUTPUTS_ROOT="${PROJECT_ROOT}/outputs"

# 模型保存根目录
export MODELS_ROOT="${PROJECT_ROOT}/models"

# SLURM 日志目录
export SLURM_LOGS="${PROJECT_ROOT}/slurm/logs"

# ==================================================
# Conda 环境配置
# ==================================================

# Conda 安装路径
export CONDA_ROOT="${HOME}/miniforge3"

# DiffSynth 环境名
export DIFFSYNTH_ENV="diffsynth"

# Video Unlearning 环境名
export VU_ENV="vu"

# ==================================================
# SLURM 配置（根据集群修改）
# ==================================================

# 默认分区（留空使用集群默认）
export SLURM_PARTITION=""

# 默认 GPU 数量
export SLURM_GPUS="1"

# 默认 CPU 数量
export SLURM_CPUS="16"

# 默认内存（GB）
export SLURM_MEM="64G"

# ==================================================
# 使用方法
# ==================================================
#
# 1. 复制此文件为 .env:
#    cp env.template .env
#
# 2. 修改 .env 中的路径为你的集群路径
#
# 3. 在脚本中加载环境变量:
#    source .env
#
# 4. 在 Python 脚本中使用:
#    import os
#    PROJECT_ROOT = os.getenv("PROJECT_ROOT")
#    VU_ROOT = os.getenv("VU_ROOT")
#
# ==================================================
